# Copy to .env to override defaults. No secrets are needed: ENA and BioSamples are public APIs.
ENA_MCP_ENA_PORTAL_URL=https://www.ebi.ac.uk/ena/portal/api
ENA_MCP_ENA_TAXONOMY_URL=https://www.ebi.ac.uk/ena/taxonomy/rest
ENA_MCP_BIOSAMPLES_URL=https://www.ebi.ac.uk/biosamples
ENA_MCP_HTTP_TIMEOUT_SECONDS=30
# stdio (local clients like Claude Desktop) or streamable-http (remote clients)
ENA_MCP_TRANSPORT=stdio
ENA_MCP_HOST=127.0.0.1
ENA_MCP_PORT=8000
